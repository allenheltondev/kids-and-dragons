{
  "name": "kids-and-dragons",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @kad/server",
    "dev:client": "npm run dev --workspace @kad/client",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/canon && tsc --noEmit -p packages/server && tsc --noEmit -p packages/client && tsc --noEmit -p tools",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "content:validate": "node tools/content/validate.mjs",
    "content:balance": "tsx tools/content/balance.ts",
    "content:graph": "tsx tools/content/graph.ts",
    "content:generate": "tsx tools/content/generate.ts",
    "canon:check": "tsx tools/canon/check.ts",
    "canon:bestiary": "tsx tools/canon/bestiary.ts",
    "canon:items": "tsx tools/canon/items.ts",
    "art:verify": "python3 tools/art/verify.py",
    "art:verify:strict": "python3 tools/art/verify.py --strict",
    "art:verify:rig": "node tools/art/verify-rig.ts",
    "art:verify:rig:strict": "node tools/art/verify-rig.ts --strict",
    "art:verify:rig:rest": "node tools/art/verify-rig-rest.mjs",
    "art:verify:rig:motion": "node tools/art/verify-rig-motion.mjs",
    "art:sheet": "python3 tools/art/sheet.py",
    "audio:verify": "tsx tools/audio/verify.ts",
    "audio:generate": "tsx tools/audio/generate.ts",
    "art:sheet:rig": "node tools/art/rig-sheet.mjs",
    "art:inventory": "node tools/art/inventory.ts",
    "art:portraits": "python3 tools/art/portraits.py",
    "build": "npm run build --workspace @kad/client",
    "e2e": "playwright test",
    "infra:build": "node infra/build.mjs",
    "infra:lint": "cfn-lint infra/template.yaml --region us-east-1 --ignore-checks I3011",
    "infra:deploy": "./scripts/deploy.sh",
    "ddb:local": "docker run --rm -p 8000:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory -sharedDb",
    "test:ddb": "KAD_DDB_ENDPOINT=http://localhost:8000 vitest run packages/server/src/store/contract.test.ts",
    "wiki:generate": "tsx tools/wiki/generate.ts",
    "wiki:build": "tsx tools/wiki/generate.ts && hugo --source wiki && pagefind --site wiki/public",
    "spike:rive": "npm run spike:rive --workspace @kad/client"
  },
  "_comment_overrides": "@anthropic-ai/bedrock-sdk brings a second @smithy/types, nested under @smithy/core. Two copies means the DynamoDB client's PutCommand and its own middleware stack are typed from different files, and packages/server stops compiling on a change that has nothing to do with it. Pinned to one.",
  "overrides": {
    "@smithy/types": "^4.17.2"
  },
  "devDependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.4",
    "@playwright/test": "^1.62.0",
    "@rive-app/canvas-advanced": "^2.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "js-yaml": "4.1.0",
    "jsdom": "^27.4.0",
    "pagefind": "1.3.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  }
}
