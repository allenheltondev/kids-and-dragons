{
  "name": "kids-and-dragons",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @kad/server",
    "dev:client": "npm run dev --workspace @kad/client",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/canon && tsc --noEmit -p packages/server && tsc --noEmit -p packages/client && tsc --noEmit -p tools",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "content:validate": "node tools/content/validate.mjs",
    "content:proofs": "node tools/content/validate.mjs --write-proofs",
    "content:continuity": "node tools/content/continuity.mjs",
    "content:balance": "tsx tools/content/balance.ts",
    "content:pacing": "tsx tools/content/pacing.ts",
    "content:graph": "tsx tools/content/graph.ts",
    "content:journey": "tsx tools/content/journey.ts",
    "canon:check": "tsx tools/canon/check.ts",
    "canon:bestiary": "tsx tools/canon/bestiary.ts",
    "canon:items": "tsx tools/canon/items.ts",
    "canon:world": "tsx tools/canon/world.ts",
    "art:atlas": "python tools/art/tile-atlas.py",
    "atlas:review": "node tools/art/review-atlas.mjs",
    "canon:field-guide": "tsx tools/canon/field-guide.ts",
    "art:verify": "python3 tools/art/verify.py",
    "art:verify:strict": "python3 tools/art/verify.py --strict",
    "art:sheet": "python3 tools/art/sheet.py",
    "art:plates": "python3 tools/art/plate-preview.py",
    "audio:verify": "tsx tools/audio/verify.ts",
    "audio:import": "tsx tools/audio/import.ts",
    "audio:briefs": "tsx tools/audio/briefs.ts",
    "audio:preview": "tsx tools/audio/procedural-preview.ts",
    "audio:install": "tsx tools/audio/procedural-install.ts",
    "load": "tsx tools/load/run.ts",
    "perf:bundle": "tsx tools/perf/bundle-budget.ts",
    "art:inventory": "node tools/art/inventory.ts",
    "art:portraits": "python3 tools/art/portraits.py",
    "art:figures": "tsx tools/art/figure-sizes.ts",
    "build": "npm run build --workspace @kad/client",
    "e2e": "playwright test",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "infra:build": "node infra/build.mjs",
    "infra:lint": "cfn-lint infra/template.yaml --region us-east-1 --ignore-checks I3011",
    "infra:deploy": "./scripts/deploy.sh",
    "ddb:local": "docker run --rm -p 8000:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory -sharedDb",
    "test:ddb": "KAD_DDB_ENDPOINT=http://localhost:8000 vitest run packages/server/src/store/contract.test.ts",
    "guide:pictures": "node tools/guide/pictures.mjs",
    "wiki:generate": "tsx tools/wiki/generate.ts",
    "wiki:build": "tsx tools/wiki/generate.ts && hugo --source wiki && pagefind --site wiki/public",
    "riftlight:preview": "tsx tools/content/riftlight-preview.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "js-yaml": "4.3.2",
    "jsdom": "^27.4.0",
    "pagefind": "1.3.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  }
}
