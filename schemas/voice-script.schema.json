{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice-script",
  "title": "A chapter's voice script",
  "description": "content/voice/scripts/<chapterId>.json: authored lines cut into spans by speaker (docs/voice-narration-plan.md section 3). Keys are line addresses.",
  "type": "object",
  "properties": {
    "$comment": { "type": "string" }
  },
  "additionalProperties": { "$ref": "#/$defs/entry" },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "lines"],
      "properties": {
        "source": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reviewed": { "type": "boolean" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "text"],
            "properties": {
              "by": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "delivery": {
                "enum": ["whisper", "excited", "hearty", "nervous", "sing-song", "gruff", "gentle", "sly", "proud", "sad"]
              }
            }
          }
        }
      }
    }
  }
}
