{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-and-dragons.local/schemas/rules.schema.json",
  "title": "RulesContent",
  "description": "content/rules.json. Mirrors packages/shared/src/types/domain.ts RulesContent; where the two disagree the TypeScript type wins. Values come from spec §4, §5, §7.1 and §8.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "baseStats",
    "creationPoints",
    "baseMaxHp",
    "baseGuard",
    "baseSteps",
    "difficultyTn",
    "levelXp",
    "tierLevels",
    "encounterBands",
    "species",
    "classes"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "baseStats": {
      "$ref": "#/$defs/stats"
    },
    "creationPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "baseMaxHp": {
      "type": "integer",
      "minimum": 1
    },
    "baseGuard": {
      "type": "integer",
      "minimum": 1
    },
    "baseSteps": {
      "type": "integer",
      "minimum": 1
    },
    "difficultyTn": {
      "description": "spec §4.1 — easy 8 / normal 12 / hard 16.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "easy",
        "normal",
        "hard"
      ],
      "properties": {
        "easy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "normal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "hard": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      }
    },
    "levelXp": {
      "description": "The thresholds above level 1: levelXp[n] is the total XP needed to reach level n+2, and maxLevel is levelXp.length + 1 (packages/shared/src/rules.ts). Levels 1-10 therefore means exactly 9 entries, none of them 0. Monotonicity is checked by tools/content/validate.mjs.",
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "helpDie": {
      "description": "Sides on the die a helper adds to a check, by the helper's tier. The d20 never changes; the help you give grows as you do.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fledgling",
        "sworn",
        "radiant",
        "mythic"
      ],
      "properties": {
        "fledgling": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "sworn": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "radiant": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "mythic": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        }
      }
    },
    "tierLevels": {
      "description": "spec §8.1 — the level at which each appearance tier is reached.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fledgling",
        "sworn",
        "radiant",
        "mythic"
      ],
      "properties": {
        "fledgling": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "sworn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "radiant": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "mythic": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "levelRewards": {
      "description": "Permanent bonuses for reaching a level, added up over every level reached (levelRewards in packages/shared/src/types/domain.ts). This is how a hero's max HP and Guard grow beyond species, Quick and trinkets. Optional.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "maxHp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "guard": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "rollXp": {
      "description": "XP for dice that go well, paid to the hero who rolled them alone and capped per hero per chapter (rollXp in packages/shared/src/types/domain.ts). Optional.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "attack",
        "chapterCap"
      ],
      "properties": {
        "check": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "attack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "defeat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "natural20": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "chapterCap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "encounterBands": {
      "type": "object",
      "description": "Enemy stat blocks by band — the counterpart of baseMaxHp/baseGuard. Canon names the band; this defines it. docs/canon-contract.md D9.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Plain-language summary, shown on wiki creature pages."
          },
          "$comment": {
            "type": "string"
          },
          "stats": {
            "type": [
              "object",
              "null"
            ],
            "description": "null means the band has no default — the creature must author its own.",
            "properties": {
              "hp": {
                "type": "integer",
                "minimum": 1
              },
              "guard": {
                "type": "integer",
                "minimum": 1
              },
              "quick": {
                "type": "integer",
                "minimum": 0
              },
              "steps": {
                "type": "integer",
                "minimum": 1
              },
              "attack": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "hp",
              "guard",
              "quick",
              "steps",
              "attack"
            ],
            "additionalProperties": false
          },
          "xp": {
            "type": "integer",
            "minimum": 0
          },
          "usualCount": {
            "type": "integer",
            "minimum": 1
          },
          "dangerLevels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "description",
          "stats",
          "xp",
          "usualCount",
          "dangerLevels"
        ],
        "additionalProperties": false
      },
      "properties": {
        "$comment": {
          "type": "string"
        }
      }
    },
    "species": {
      "description": "All six, keyed by SpeciesId. Missing or unknown keys are a build failure — the creation flow reads this map directly.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unicorn",
        "dragonling",
        "griffin",
        "bigfoot",
        "kitsune",
        "manticore"
      ],
      "properties": {
        "unicorn": {
          "type": "object",
          "$ref": "#/$defs/species",
          "properties": {
            "id": {
              "const": "unicorn"
            }
          }
        },
        "dragonling": {
          "type": "object",
          "$ref": "#/$defs/species",
          "properties": {
            "id": {
              "const": "dragonling"
            }
          }
        },
        "griffin": {
          "type": "object",
          "$ref": "#/$defs/species",
          "properties": {
            "id": {
              "const": "griffin"
            }
          }
        },
        "bigfoot": {
          "type": "object",
          "$ref": "#/$defs/species",
          "properties": {
            "id": {
              "const": "bigfoot"
            }
          }
        },
        "kitsune": {
          "type": "object",
          "$ref": "#/$defs/species",
          "properties": {
            "id": {
              "const": "kitsune"
            }
          }
        },
        "manticore": {
          "type": "object",
          "$ref": "#/$defs/species",
          "properties": {
            "id": {
              "const": "manticore"
            }
          }
        }
      }
    },
    "classes": {
      "description": "All four, keyed by ClassId, one per stat.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thornguard",
        "duskrunner",
        "starweaver",
        "songkeeper"
      ],
      "properties": {
        "thornguard": {
          "type": "object",
          "$ref": "#/$defs/class",
          "properties": {
            "id": {
              "const": "thornguard"
            },
            "stat": {
              "const": "might"
            }
          }
        },
        "duskrunner": {
          "type": "object",
          "$ref": "#/$defs/class",
          "properties": {
            "id": {
              "const": "duskrunner"
            },
            "stat": {
              "const": "quick"
            }
          }
        },
        "starweaver": {
          "type": "object",
          "$ref": "#/$defs/class",
          "properties": {
            "id": {
              "const": "starweaver"
            },
            "stat": {
              "const": "clever"
            }
          }
        },
        "songkeeper": {
          "type": "object",
          "$ref": "#/$defs/class",
          "properties": {
            "id": {
              "const": "songkeeper"
            },
            "stat": {
              "const": "heart"
            }
          }
        }
      }
    },
    "fittingStall": {
      "description": "The Exchange's fitting stall (docs/class-mastery.md §1, #312): where a new hero may swap class once, for free, to any class. Optional: rules without it have no stall.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stands",
        "keeper",
        "narration"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "stands": {
          "description": "The scenes it stands in: a Story or Choice Point scene at the Exchange that every party walks through as its campaign opens. content:validate checks each names a real scene that is neither an ending nor a class place.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chapterId",
              "sceneId"
            ],
            "properties": {
              "chapterId": {
                "type": "string",
                "minLength": 1
              },
              "sceneId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "keeper": {
          "description": "The tailor's name, for the phone. The narration introduces her first.",
          "type": "string",
          "minLength": 1
        },
        "narration": {
          "description": "What the shared screen says while the stall is open.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "matchups": {
      "description": "Who is good and bad against what (docs/matchups.md). Mirrors packages/shared/src/types/matchups.ts MatchupRules. Optional: rules without it play with no matchups. content:validate checks the ids edges name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["traits", "checkTags", "edges", "opinion", "exemptCampaigns"],
      "properties": {
        "$comment": { "type": "string" },
        "traits": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "icon", "text", "hint"],
            "properties": {
              "$comment": { "type": "string" },
              "name": { "type": "string", "minLength": 1 },
              "icon": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "hint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "checkTags": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "text"],
            "properties": {
              "$comment": { "type": "string" },
              "name": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "hero", "on", "text"],
            "properties": {
              "$comment": { "type": "string" },
              "id": { "type": "string", "minLength": 1 },
              "hero": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "species": { "$ref": "#/$defs/matchupIdOrIds" },
                  "class": { "$ref": "#/$defs/matchupIdOrIds" }
                }
              },
              "on": { "enum": ["attack", "defend", "check"] },
              "foe": { "$ref": "#/$defs/matchupIdOrIds" },
              "ability": { "$ref": "#/$defs/matchupIdOrIds" },
              "tag": { "$ref": "#/$defs/matchupIdOrIds" },
              "roll": { "type": "integer", "minimum": -2, "maximum": 2 },
              "damage": { "type": "integer", "minimum": -2, "maximum": 2 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "opinion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["likedFoeRoll", "dislikedFoeRoll", "likedCheckRoll", "dislikedCheckRoll"],
          "properties": {
            "likedFoeRoll": { "type": "integer", "minimum": -2, "maximum": 2 },
            "dislikedFoeRoll": { "type": "integer", "minimum": -2, "maximum": 2 },
            "likedCheckRoll": { "type": "integer", "minimum": -2, "maximum": 2 },
            "dislikedCheckRoll": { "type": "integer", "minimum": -2, "maximum": 2 }
          }
        },
        "exemptCampaigns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "matchupIdOrIds": {
      "description": "One id, or a non-empty list of ids.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "statId": {
      "description": "The four stats and nothing else. spec §4.1.",
      "enum": [
        "might",
        "quick",
        "clever",
        "heart"
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "might",
        "quick",
        "clever",
        "heart"
      ],
      "properties": {
        "might": {
          "type": "integer"
        },
        "quick": {
          "type": "integer"
        },
        "clever": {
          "type": "integer"
        },
        "heart": {
          "type": "integer"
        }
      }
    },
    "slug": {
      "description": "An icon slug, not a path. The client resolves it to inline SVG (spec §11, 'icons before text').",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "icon"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "blurb",
        "passive",
        "worldAbility",
        "combatAction"
      ],
      "properties": {
        "id": {
          "enum": [
            "unicorn",
            "dragonling",
            "griffin",
            "bigfoot",
            "kitsune",
            "manticore"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "blurb": {
          "type": "string",
          "minLength": 1
        },
        "passive": {
          "description": "A flat stat bonus or extra max HP. A passive that grants neither is a mistake, so one of the two is required.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "text"
          ],
          "anyOf": [
            {
              "type": "object",
              "required": [
                "stat"
              ],
              "properties": {
                "stat": {
                  "$ref": "#/$defs/statId"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "maxHp"
              ],
              "properties": {
                "maxHp": {
                  "type": "integer"
                }
              }
            }
          ],
          "properties": {
            "stat": {
              "$ref": "#/$defs/statId"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "maxHp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "worldAbility": {
          "$ref": "#/$defs/ability"
        },
        "combatAction": {
          "description": "The combat-flavored version of the world ability, once per encounter (spec §7.2).",
          "$ref": "#/$defs/ability"
        }
      }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "stat",
        "role",
        "blurb",
        "baseSteps",
        "signature",
        "unlocks",
        "deeds"
      ],
      "properties": {
        "id": {
          "enum": [
            "thornguard",
            "duskrunner",
            "starweaver",
            "songkeeper"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stat": {
          "$ref": "#/$defs/statId"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "blurb": {
          "type": "string",
          "minLength": 1
        },
        "baseSteps": {
          "description": "spec §7.1 — base 4 steps, Duskrunner 6.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "signature": {
          "$ref": "#/$defs/ability"
        },
        "unlocks": {
          "description": "Actions unlocked at levels beyond the signature, keyed by level as a string.",
          "type": "object",
          "propertyNames": {
            "pattern": "^([2-9]|10)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ability"
          }
        },
        "deeds": {
          "description": "What earns each distinction (docs/class-mastery.md §6). Either track of a rank completes it. Deed ids are the ones the game counts (packages/shared/src/deeds.ts, DEED_IDS in domain.ts).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apprentice",
            "expert",
            "master"
          ],
          "properties": {
            "apprentice": {
              "$ref": "#/$defs/rankDeeds"
            },
            "expert": {
              "$ref": "#/$defs/rankDeeds"
            },
            "master": {
              "$ref": "#/$defs/rankDeeds"
            }
          }
        }
      }
    },
    "rankDeeds": {
      "description": "One rank: withFriends counts at any table; alone, when present, too, so a solo hero always has a way. Absent alone means the same deeds serve both.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withFriends"
      ],
      "properties": {
        "withFriends": {
          "$ref": "#/$defs/deedTrack"
        },
        "alone": {
          "$ref": "#/$defs/deedTrack"
        }
      }
    },
    "deedTrack": {
      "description": "Every deed in the track, at least this many times. For song_hearts the count is hearts.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "brace_friend",
          "hold_ground",
          "shove_off_friend",
          "shove",
          "bramble_wall_fight",
          "new_target",
          "vanish_miss",
          "twin_step_finish",
          "burst_two",
          "burst_three",
          "glimmer_made",
          "tangle_guard",
          "tanglelight",
          "song_hearts",
          "class_story"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  }
}
