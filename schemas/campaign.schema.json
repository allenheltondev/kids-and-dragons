{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-and-dragons.local/schemas/campaign.schema.json",
  "title": "Campaign",
  "description": "content/campaigns/*.json. Mirrors packages/shared/src/types/chapter.ts Campaign; where the two disagree the TypeScript type wins. A campaign is a story arc of 4-8 chapters and the unit of the carryover commitment rule (spec \u00a76, \u00a78.2). A campaign with `graph` is a graph campaign (#192, docs/campaigns/graph-campaigns.md): its next chapter is chosen by the graph's edges rather than by chapter index. Without `graph` it is an ordered campaign, read exactly as before.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "blurb",
    "chapters"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "_note": {
      "description": "Author-facing note that survives into the shipped JSON. Ignored by the loader.",
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "blurb": {
      "type": "string",
      "minLength": 1
    },
    "chapters": {
      "description": "Every chapter file in the campaign, including every member of a routed beat. Each must exist under content/chapters/. For an ordered campaign the set of distinct `index` values must run 1..n with no gaps, and a routed index must cover its route set exactly \u2014 checked by tools/content/validate.mjs. For a graph campaign every listed chapter must be played by some node and no chapter may declare a `route`; `index` is not read.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "routeSets": {
      "description": "Named sets of story flags a routed beat chooses from, e.g. the three roads north, or the three pursuits. Declared here rather than inferred from the files that exist, because the failure worth catching is a *missing* member: only a declared set can notice an absence.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "setbackLimit": {
      "description": "Setbacks before the campaign fails \u2014 spec \u00a78.3's 'fails at three setbacks, tunable per campaign'. Absent means 3.",
      "type": "integer",
      "minimum": 1
    },
    "purseBackfill": {
      "description": "Campaign.purseBackfill: the purse for an attempt saved before the party purse existed. `coins` is the base; `byFlag` adds an amount per carried route flag the attempt holds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coins"
      ],
      "properties": {
        "coins": {
          "type": "integer",
          "minimum": 0
        },
        "byFlag": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "graph": {
      "$ref": "#/$defs/graph"
    }
  },
  "$defs": {
    "graphId": {
      "description": "A node or edge id. Stable: saved attempts name it, so renaming one is a content migration.",
      "type": "string",
      "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"
    },
    "chapterId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "flag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "graph": {
      "description": "CampaignGraph (packages/shared/src/types/campaign-graph.ts). Optional and versioned: absent means an ordered campaign. Every name in it must resolve (parseCampaignGraph), checked by tools/content/validate.mjs and at server startup.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "entry",
        "nodes",
        "edges"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "version": {
          "description": "The declaration version. This build reads 1 and refuses any other.",
          "const": 1
        },
        "entry": {
          "description": "The node a fresh attempt starts at.",
          "$ref": "#/$defs/graphId"
        },
        "nodes": {
          "description": "The places, keyed by stable node id, in authored order.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/graphId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/graphNode"
          }
        },
        "edges": {
          "description": "The ways between places, keyed by stable edge id. A node's exits are offered in this order.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/graphId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/graphEdge"
          }
        },
        "flags": {
          "description": "Journey flags beyond routeSets members: seeded into every chapter run of the attempt and read back when its chapter completes.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "facts": {
          "description": "World facts (#198): typed, bounded, attempt-scoped values the journey carries beside its flags \u2014 a place displaced or restored, a threat sleeping or cleared, favours owed, a road open. Written by edge effects and node onComplete rules, read by guards and variants. Keyed by stable fact id, in authored order.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/graphId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/worldFact"
          }
        }
      }
    },
    "graphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "chapter": {
          "description": "The chapter played here; a member of the campaign's chapters.",
          "$ref": "#/$defs/chapterId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revisit": {
          "description": "Entering after this node completed: replay (default) plays it again, pass walks through to the exit choice, closed forbids it.",
          "enum": [
            "replay",
            "pass",
            "closed"
          ]
        },
        "variants": {
          "description": "A different chapter for this place when its condition holds. First match wins, on every entry that plays the node.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chapter",
              "when"
            ],
            "properties": {
              "chapter": {
                "$ref": "#/$defs/chapterId"
              },
              "when": {
                "$ref": "#/$defs/graphCondition"
              },
              "revisit": {
                "description": "Re-entering the (completed) node while this variant is the place: replay or pass, overriding the node's revisit (#198).",
                "enum": [
                  "replay",
                  "pass"
                ]
              }
            }
          }
        },
        "onComplete": {
          "description": "Completion rules (#198): when the node's chapter completes, every rule whose `when` holds (read after the outcome is recorded and the journey flags read back) applies its effects, in order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effects"
            ],
            "properties": {
              "$comment": {
                "type": "string"
              },
              "when": {
                "$ref": "#/$defs/graphCondition"
              },
              "effects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/graphEffect"
                }
              }
            }
          }
        },
        "ending": {
          "description": "Makes this node an ending: completing its chapter completes the attempt. An ending has no exits.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/graphId"
        },
        "to": {
          "$ref": "#/$defs/graphId"
        },
        "kind": {
          "description": "forward: onward. sideways: a neighboring place at the same point in the story. return: back to somewhere the story has been, which is what makes a cycle intentional.",
          "enum": [
            "forward",
            "sideways",
            "return"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/graphCondition"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/graphEffect"
          }
        },
        "locked": {
          "description": "Unavailable until an unlock effect opens it.",
          "const": true
        },
        "once": {
          "description": "May be taken once per attempt.",
          "const": true
        },
        "irreversible": {
          "description": "The author's claim that there is no way back to `from` after taking it. Checked by tooling, shown as a warning; not enforced.",
          "const": true
        },
        "blocked": {
          "description": "How the exit is drawn while unavailable. hidden (default) or shown.",
          "enum": [
            "hidden",
            "shown"
          ]
        }
      }
    },
    "graphCondition": {
      "description": "GraphCondition: every field present must hold. Reads the journey only, never the party.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flag": {
          "$ref": "#/$defs/flag"
        },
        "notFlag": {
          "$ref": "#/$defs/flag"
        },
        "visited": {
          "oneOf": [
            {
              "$ref": "#/$defs/graphId"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/graphId"
              }
            }
          ]
        },
        "notVisited": {
          "oneOf": [
            {
              "$ref": "#/$defs/graphId"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/graphId"
              }
            }
          ]
        },
        "completed": {
          "oneOf": [
            {
              "$ref": "#/$defs/graphId"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/graphId"
              }
            }
          ]
        },
        "notCompleted": {
          "oneOf": [
            {
              "$ref": "#/$defs/graphId"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/graphId"
              }
            }
          ]
        },
        "traversed": {
          "oneOf": [
            {
              "$ref": "#/$defs/graphId"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/graphId"
              }
            }
          ]
        },
        "notTraversed": {
          "oneOf": [
            {
              "$ref": "#/$defs/graphId"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/graphId"
              }
            }
          ]
        },
        "outcome": {
          "description": "How the subject node's most recent completion ended: the edge's `from`, or a variant's own node.",
          "enum": [
            "success",
            "setback"
          ]
        },
        "visit": {
          "description": "The subject node's visit ordinal is within these bounds (inclusive): on an edge, the visit to `from` being finished; on a variant, the visit being begun; in onComplete, the visit completing.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "facts": {
          "description": "World facts, each tested: a bare value (equals), or { in, not, min, max } \u2014 every key present must hold. A fact never written reads as its initial.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/graphId"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/factValue"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "in": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/graphId"
                        },
                        {
                          "type": "integer"
                        }
                      ]
                    }
                  },
                  "not": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/graphId"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "min": {
                    "type": "integer"
                  },
                  "max": {
                    "type": "integer"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "graphEffect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "flag"
          ],
          "properties": {
            "type": {
              "const": "setFlag"
            },
            "flag": {
              "$ref": "#/$defs/flag"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "edge"
          ],
          "properties": {
            "type": {
              "enum": [
                "unlock",
                "lock"
              ]
            },
            "edge": {
              "$ref": "#/$defs/graphId"
            }
          }
        },
        {
          "description": "Sets a world fact (#198) to a value in its domain.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "fact",
            "value"
          ],
          "properties": {
            "type": {
              "const": "setFact"
            },
            "fact": {
              "$ref": "#/$defs/graphId"
            },
            "value": {
              "$ref": "#/$defs/factValue"
            }
          }
        },
        {
          "description": "Moves a counter world fact (#198) by a non-zero integer, clamped to its bounds.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "fact",
            "by"
          ],
          "properties": {
            "type": {
              "const": "adjustFact"
            },
            "fact": {
              "$ref": "#/$defs/graphId"
            },
            "by": {
              "type": "integer",
              "not": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "worldFact": {
      "description": "WorldFact (packages/shared/src/types/campaign-graph.ts). An enum (one of 2-12 states), a counter (integers min..max, span at most 20) or a flag. `domain` groups it for the tools and screens; `visible` shows it to the players.",
      "type": "object",
      "required": [
        "domain",
        "type"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "domain": {
          "enum": [
            "locale",
            "threat",
            "alliance",
            "route",
            "consequence"
          ]
        },
        "type": {
          "enum": [
            "enum",
            "counter",
            "flag"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "const": true
        },
        "values": true,
        "initial": true,
        "min": true,
        "max": true
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/graphId"
              }
            },
            "initial": {
              "$ref": "#/$defs/graphId"
            },
            "min": false,
            "max": false
          },
          "required": [
            "values",
            "initial"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "counter"
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            },
            "initial": {
              "type": "integer"
            },
            "values": false
          },
          "required": [
            "min",
            "max",
            "initial"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "flag"
            },
            "initial": {
              "type": "boolean"
            },
            "values": false,
            "min": false,
            "max": false
          }
        }
      ]
    },
    "factValue": {
      "description": "A world fact's value: an enum state, a counter's integer, a flag's boolean.",
      "oneOf": [
        {
          "$ref": "#/$defs/graphId"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        }
      ]
    }
  }
}
