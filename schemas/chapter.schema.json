{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-and-dragons.local/schemas/chapter.schema.json",
  "title": "Chapter",
  "description": "content/chapters/*.json. Mirrors packages/shared/src/types/chapter.ts Chapter; where the two disagree the TypeScript type wins. Worked example: architecture \u00a75. The graph-level rules a schema cannot express \u2014 every goto resolves, every scene is reachable, no dead ends, every itemId is in the catalog \u2014 are enforced by tools/content/validate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "campaignId",
    "index",
    "title",
    "biome",
    "estimatedMinutes",
    "xpAward",
    "entry",
    "scenes"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/kebabId"
    },
    "campaignId": {
      "$ref": "#/$defs/kebabId"
    },
    "index": {
      "description": "Position within the campaign, 1-based. NOT unique: a routed beat has one chapter file per route, all sharing an index (see `route`). tools/content/validate.mjs checks that the set of distinct indexes runs 1..n with no gaps.",
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "biome": {
      "description": "Selects backdrop, palette, tile set and music. Membership is validated against assets/manifest.json.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "music": {
      "description": "Optional track that replaces the biome's music for this chapter. A scene's own `music` wins over it. Absent means the biome's track.",
      "$ref": "#/$defs/musicTrack"
    },
    "estimatedMinutes": {
      "description": "A chapter is one sitting: ~30 minutes, spec \u00a73 of the design principles.",
      "type": "integer",
      "minimum": 5,
      "maximum": 60
    },
    "xpAward": {
      "description": "Awarded for completing the chapter, not per enemy (spec \u00a78.1).",
      "type": "integer",
      "minimum": 0
    },
    "entry": {
      "$ref": "#/$defs/sceneId"
    },
    "objectives": {
      "description": "Optional bonus objectives (spec \u00a78.2). They pay the whole party or nobody, never an individual. The 25%-of-xpAward ceiling on their total is a cross-field rule and is enforced by tools/content/validate.mjs.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "props": {
      "description": "Chapter-scoped props (D7): items this chapter brings with it that the world does not otherwise have. The world owns a honeycake; a chapter owns the key to its own door. These project into content/items.json alongside canon's items, because a quest item outlives the chapter that granted it and an inventory screen still has to name it \u2014 so the ids must not collide with canon's, which tools/canon/items.ts enforces. Same shape as an entry in schemas/items.schema.json.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "$comment": {
          "type": "string"
        }
      },
      "propertyNames": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          {
            "const": "$comment"
          }
        ]
      },
      "additionalProperties": {
        "$ref": "https://kids-and-dragons.local/schemas/items.schema.json#/$defs/itemDef"
      }
    },
    "route": {
      "description": "Which member of a routed index this chapter is. Absent means the index has exactly one chapter, which is the ordinary case. `set` names a list in the campaign's `routeSets`; `flag` is the story flag that selects this member. See packages/shared/src/routes.ts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "flag"
      ],
      "properties": {
        "set": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "flag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "scenes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/sceneId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/scene"
      }
    },
    "llmHints": {
      "description": "Feeds the live layer's cached prefix and its safety validator (architecture \u00a76.3, \u00a76.5).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone",
        "vocabulary",
        "forbidden"
      ],
      "properties": {
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "vocabulary": {
          "type": "string",
          "minLength": 1
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "npcVoices": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "sceneId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "musicTrack": {
      "description": "A MUSIC_SPECS key in packages/client/src/audio/paths.ts. Membership is validated by tools/content/validate.mjs.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "statId": {
      "enum": [
        "might",
        "quick",
        "clever",
        "heart"
      ]
    },
    "speciesId": {
      "enum": [
        "unicorn",
        "dragonling",
        "griffin",
        "bigfoot",
        "kitsune",
        "manticore"
      ]
    },
    "classId": {
      "enum": [
        "thornguard",
        "duskrunner",
        "starweaver",
        "songkeeper"
      ]
    },
    "grantTarget": {
      "description": "\"roller\" (whoever made the check), \"party\" (prompt for a holder), or a playerId. architecture \u00a75.",
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "description": "Effect in chapter.ts. An unknown `type` is a build failure.",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "grantItem",
            "grantQuestItem",
            "damage",
            "heal",
            "grantXp",
            "setFlag",
            "takeItem",
            "grantCoins",
            "spendCoins"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "grantItem"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "itemId"
            ],
            "properties": {
              "itemId": {
                "$ref": "#/$defs/itemId"
              },
              "to": {
                "$ref": "#/$defs/grantTarget"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "grantQuestItem"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "itemId"
            ],
            "properties": {
              "itemId": {
                "$ref": "#/$defs/itemId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "damage"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "$comment": "Nobody dies (spec \u00a72 of the design principles) \u2014 chapter damage is a scratch, not a threat.",
            "required": [
              "amount"
            ],
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "to": {
                "$ref": "#/$defs/grantTarget"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heal"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "amount"
            ],
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "to": {
                "$ref": "#/$defs/grantTarget"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "grantXp"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "amount"
            ],
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "setFlag"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "flag"
            ],
            "properties": {
              "flag": {
                "$ref": "#/$defs/flag"
              },
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "takeItem"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "itemId"
            ],
            "properties": {
              "itemId": {
                "description": "One id, or a list in order of preference: the first one anybody holds is taken.",
                "oneOf": [
                  {
                    "$ref": "#/$defs/itemId"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/itemId"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "grantCoins"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "amount"
            ],
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "spendCoins"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "amount"
            ],
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              }
            }
          }
        }
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "flag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "outcome": {
      "description": "How this ending ends the chapter (spec \u00a78.2): success pays the full xpAward, setback pays half, rounded down. Absent means success, so existing content needs no edit. Only read on a scene with an empty `choices` array \u2014 the validator rejects it anywhere else.",
      "enum": [
        "success",
        "setback"
      ]
    },
    "discovers": {
      "description": "Canon ids (keys of content/field-guide.json entries) the kids actually meet in this scene, so the Field Guide fills in. Tag a thing only when the scene lets them meet it, never for a mere mention. The validator rejects unknown ids and duplicates. A fight's creatures and the chapter's biome are discovered implicitly and need no tag.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]+\\.[a-z0-9_]+$"
      }
    },
    "cast": {
      "description": "Who is standing in this scene with the party, drawn on the shared screen opposite them (CastMember in chapter.ts). Name only the people and creatures physically present and part of the moment, never a mere mention. At most three, so the party is never crowded off its own stage. The validator resolves every figure to a file under assets/.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/castMember"
      }
    },
    "castMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure"
      ],
      "properties": {
        "figure": {
          "description": "entities/<id> (assets/entities/<id>/assembled.png), characters/<species> (that species' fledgling art), or cast/<id> (a named character's own figure, assets/cast/<id>/assembled.png).",
          "type": "string",
          "pattern": "^(entities|characters|cast)/[a-z0-9]+([_-][a-z0-9]+)*$"
        },
        "name": {
          "description": "What the nameplate under the figure says, e.g. \"Professor Tidewell\". Omit for an unnamed creature, which then stands without a nameplate.",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "size": {
          "description": "How big the figure stands beside the party. Defaults to the entity's manifest scale, or medium (party-sized).",
          "enum": [
            "tiny",
            "tiny_to_small",
            "small",
            "small_to_medium",
            "medium",
            "medium_to_large",
            "large",
            "very_large",
            "colossal"
          ]
        },
        "count": {
          "description": "How many of this figure are present (default 1). Set it whenever the narration gives a number (\"three cinder wolves\"); the stage draws that many, huddled together, under one nameplate.",
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "endsCampaign": {
      "description": "This ending finishes the whole campaign, not just the chapter: the attempt completes and the party's gains commit, exactly as finishing the campaign's last beat does. For an authored exit before the last beat, such as Gemfall's Walk. Only read on a scene with an empty `choices` array \u2014 the validator rejects it anywhere else.",
      "const": true
    },
    "objective": {
      "description": "ChapterObjective in chapter.ts. `flag` is watched, not set \u2014 author a setFlag effect wherever the thing happens and point at it. There is no second mechanism.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "flag",
        "xp"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "$comment": "Shown on the completion screen, so it is held to the same length as a choice label.",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "flag": {
          "$ref": "#/$defs/flag"
        },
        "xp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "choice": {
      "description": "Choice in chapter.ts. `goto` is required \u2014 a choice that leads nowhere is the single most common authoring mistake and it must fail the build, not the table.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "icon",
        "goto"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "icon": {
          "$ref": "#/$defs/slug"
        },
        "goto": {
          "$ref": "#/$defs/sceneId"
        },
        "requiresSpecies": {
          "description": "Hidden, not greyed out, when nobody in the party matches (architecture \u00a75).",
          "oneOf": [
            {
              "$ref": "#/$defs/speciesId"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/speciesId"
              }
            }
          ]
        },
        "requiresClass": {
          "description": "Same as requiresSpecies, for class: offered when anyone seated has one of these classes, hidden otherwise. Judged against the seated party, never stored; set a flag in effects for later guards to read.",
          "oneOf": [
            {
              "$ref": "#/$defs/classId"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/classId"
              }
            }
          ]
        },
        "requiresFlag": {
          "$ref": "#/$defs/flag"
        },
        "requiresItem": {
          "$ref": "#/$defs/itemId"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "choices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goto"
      ],
      "properties": {
        "goto": {
          "$ref": "#/$defs/sceneId"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "variants": {
          "$ref": "#/$defs/variants"
        }
      }
    },
    "enemySpec": {
      "$comment": "The AUTHORED shape (AuthoredEnemySpec in packages/shared/src/bestiary.ts). Everything canon can supply is optional here and filled by the content loader from content/bestiary.json; EnemySpec, the loaded shape the engine sees, requires all of it. `anyOf` below is the trade: name a creature and inherit, or write every number yourself.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "anyOf": [
        {
          "$comment": "Borrowing from canon. (The stubbed `properties` are only here to satisfy ajv's strictRequired, which wants every required key declared in the same subschema; the real definitions are below.)",
          "required": [
            "creature"
          ],
          "properties": {
            "creature": {}
          }
        },
        {
          "$comment": "A one-off with no canon creature behind it says every number itself.",
          "required": [
            "count",
            "hp",
            "guard",
            "quick",
            "steps",
            "attack"
          ],
          "properties": {
            "count": {},
            "hp": {},
            "guard": {},
            "quick": {},
            "steps": {},
            "attack": {}
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "$comment": "3 players vs 2-4 enemies, never more (spec \u00a77.1).",
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "creature": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
          "description": "Canon creature asset_id \u2014 the join to canon/creatures.yaml and content/bestiary.json. Naming one inherits count, name, art and every stat; anything also written below is an override, and tools/content/validate.mjs refuses an override that merely restates canon's own number."
        },
        "hp": {
          "type": "integer",
          "minimum": 1
        },
        "guard": {
          "type": "integer",
          "minimum": 1
        },
        "quick": {
          "$comment": "Initiative, same scale as a character's Quick (spec \u00a77.2). Authored, never inferred from guard \u2014 see EnemySpec in types/chapter.ts.",
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "attack": {
          "type": "integer",
          "minimum": 0
        },
        "art": {
          "type": "string",
          "minLength": 1
        },
        "onHit": {
          "$comment": "A numbing sting (#227): every hit this enemy lands Numbs the hero it hits. Opt-in; absent means the enemy fights as it always did.",
          "$ref": "#/$defs/numbingSting"
        },
        "retaliation": {
          "$comment": "The same sting as a defense (#227), pufferfish-style: the enemy starts un-puffed, the first hero hit puffs it (that hit does not sting), and while puffed a hero who hits it is Numbed. `puffTurns` is how many of its own turns it stays puffed (default 2, DEFAULT_PUFF_TURNS in buffs.ts); another hit while puffed starts the count again.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slow"
          ],
          "properties": {
            "slow": {
              "$ref": "#/$defs/numbingSting/properties/slow"
            },
            "puffTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        }
      }
    },
    "numbingSting": {
      "$comment": "SlowEffect in packages/shared/src/types/buffs.ts. Numbed is a \"move\" burden on the hero for their next `turns` turns; it does not stack, ends with the fight, and steps floor at 1. Limits mirror BUFF_LIMITS.move and MAX_BUFF_DURATION in buffs.ts, which tools/content/validate.mjs also enforces.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slow"
      ],
      "properties": {
        "slow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps",
            "turns"
          ],
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "description": "Scene in chapter.ts. An unknown scene type is a build failure.",
          "enum": [
            "story",
            "check",
            "choice_point",
            "rest",
            "encounter"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "story"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/storyScene"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "check"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/checkScene"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice_point"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/choicePointScene"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rest"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/restScene"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "encounter"
              }
            },
            "required": [
