    "condition": {
      "description": "Condition in chapter.ts. Every field present must hold (ANDed); an empty condition always holds. The validator checks flags and items against content.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flag": {
          "$ref": "#/$defs/flag"
        },
        "notFlag": {
          "$ref": "#/$defs/flag"
        },
        "item": {
          "$ref": "#/$defs/itemId"
        },
        "notItem": {
          "$ref": "#/$defs/itemId"
        },
        "count": {
          "description": "Distinct item ids the party holds that match `of`: an exact id, a prefix ending in `*`, or a list of exact ids. Bounds inclusive; max 0 means none.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "of"
          ],
          "properties": {
            "of": {
              "oneOf": [
