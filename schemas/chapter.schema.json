    "encounterEnvironment": {
      "description": "EncounterEnvironment in chapter.ts (#201): the place fighting back. Every part optional; a scene without it fights exactly as before. Rules fire at turn ends and round starts only. See docs/campaigns/graph-campaigns.md, \"Environmental combat (#201)\".",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "$comment": {
          "type": "string"
        },
        "clock": {
          "description": "The visible rift timer, in rounds. collapse: the fight ends after the last round and takes onTimeout. surge: it goes on, and every later round hurts each hero by `surge` (default 1).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rounds",
            "label",
            "onExpire"
          ],
          "properties": {
            "rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "onExpire": {
              "enum": [
                "collapse",
                "surge"
              ]
            },
            "surge": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        },
        "hazards": {
          "description": "Ground that bites: a figure that ENDS its turn on an active hazard tile takes `damage`, then is slowed, held (`root`) or thrown (`push`) if the hazard says so (#220). At least one of the four (content:validate).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "label",
              "tiles"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"
              },
              "kind": {
                "enum": [
                  "fire",
                  "thorns",
                  "rift"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "tiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/mapTile"
                }
              },
              "damage": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "1 to 5. Absent: the ground does not hurt, only slows, holds or pushes (#220)."
              },
              "slow": {
                "description": "#220 sticky ground: Slowed, `steps` fewer steps for `turns` of the figure's own turns. Refreshes, never stacks.",
                "$ref": "#/$defs/numbingSting/properties/slow"
              },
              "root": {
                "description": "#220 grabbing ground: the figure starts its next turn with no steps.",
                "const": true
              },
              "push": {
                "description": "#220 ground that throws: the figure slides `tiles` (default 1) toward `direction` (north is up the map), stopping at a wall, the edge or a figure.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "direction"
                ],
                "properties": {
                  "direction": {
                    "enum": [
                      "north",
                      "south",
                      "east",
                      "west"
                    ]
                  },
                  "tiles": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  }
                }
              },
              "fromRound": {
                "description": "Active from this round (default 1).",
                "type": "integer",
                "minimum": 1
              },
              "untilRound": {
                "description": "Active through this round (default: the rest of the fight).",
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "exits": {
          "description": "Timed ways out: a hero who ENDS a turn on an open exit tile steps through. When every standing hero is through, the fight takes onEscape.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "tiles"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "tiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/mapTile"
                }
              },
              "opensRound": {
                "description": "Open from this round (default 1).",
                "type": "integer",
                "minimum": 1
              },
              "closesRound": {
                "description": "Open through this round (default: the rest of the fight).",
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "rescue": {
          "description": "Somebody to save, standing on `at`. Freed when a hero ENDS a turn beside them; lost after `byRound` (default: when the clock runs out). `effects` apply when the fight ends, if freed.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "at"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "$ref": "#/$defs/mapTile"
            },
            "byRound": {
              "description": "The last round they can be freed in.",
              "type": "integer",
              "minimum": 1
            },
            "effects": {
              "$ref": "#/$defs/effects"
            }
          }
        },
        "relocate": {
          "description": "The rift moves a monster: at the start of `round`, enemy `<spec id>#<n>` goes to `to`, if it still stands and the tile is free.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "round",
              "enemy",
              "to"
            ],
            "properties": {
              "round": {
                "type": "integer",
                "minimum": 2
              },
              "enemy": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*#[1-9][0-9]*$"
              },
              "to": {
                "$ref": "#/$defs/mapTile"
              }
            }
          }
        }
      }
    },
    "priority": {
      "description": "ScenePriority in chapter.ts. 1 is a revelation the campaign turns on, 2 a clue worth remembering; absent is an ordinary scene. Drawn differently on the shared screen, and never rewritten by the live layer. content/README.md, \"Priority scenes\".",
      "enum": [
        1,
        2
      ]
    }
  }
