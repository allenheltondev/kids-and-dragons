    ["body", "leg_l"],
    ["body", "leg_r"],
    ["body", "tail"],
    ["body", "armor_visible"]
  ],
  "zOrder": [
    "wings",
    "tail",
    "leg_l",
    "leg_r",
    "body",
    "arm_l",
    "arm_r",
    "head",
    "mane",
    "armor_visible"
  ],
  "origin": { "x": 512, "y": 900 },
