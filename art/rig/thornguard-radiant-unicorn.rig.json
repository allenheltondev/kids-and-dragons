{
  "$comment": "Thornguard Radiant Unicorn variant rig. The approved geared portrait is painted into the normal unicorn parts so armor follows each existing bone. armor_underlay is a torso-bound continuity layer behind every anatomy part; armor_visible carries only armor pixels that protrude beyond the anatomy masks. Clip timing and inputs derive from assets/manifest.json rigContract (--contract --set hero).",
  "root": "body",
  "adjacency": [
    ["body", "head"],
    ["head", "mane"],
    ["head", "horn"],
    ["body", "arm_l"],
    ["body", "arm_r"],
    ["body", "leg_l"],
    ["body", "leg_r"],
    ["body", "tail"],
    ["body", "armor_underlay"],
    ["body", "armor_visible"]
  ],
  "zOrder": [
    "armor_underlay",
    "tail",
    "leg_l",
    "leg_r",
    "body",
    "arm_l",
    "arm_r",
    "head",
    "armor_visible",
    "mane",
    "horn"
  ],
  "origin": {
    "x": 512,
    "y": 900
  },
  "ground": {
    "x": 700,
    "y": 1088
  },
  "artboardWidth": 1400,
  "artboardHeight": 1400,
  "scale": 1,
  "wiring": {
    "triggers": {
      "move": "walk",
      "helpUp": "lift"
    },
    "when": {
      "down": {
        "input": "knockedDown",
        "equals": true,
        "from": ["idle", "hurt", "walk", "guard"]
      },
      "revive": {
        "input": "knockedDown",
        "equals": false,
        "from": "down_loop"
      }
    }
  }
}
