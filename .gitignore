# dependencies
node_modules/
.venv/
__pycache__/
*.py[cod]

# art workflow — nothing reaches assets/ without passing verify + human review
staging/

# build output
dist/
.aws-sam/
cdk.out/
*.tsbuildinfo

# wiki generator manifest (local dev state, regenerated on each run)
wiki/.gen-manifest.json
wiki/public/
wiki-public/

# bundled Lambda artifacts — infra/build.mjs regenerates these on every deploy
infra/.build/

# local dev-server table (DynamoDB Local's stand-in)
.data/

# local
.env
.env.local
*.local
.DS_Store
.kiro
.vscode

# playwright
test-results/
playwright-report/

# scratch git worktrees for background agents — each is a full checkout of this
# repo *inside* this repo, created and reaped by the tooling. `.claude/` itself
# is tracked (settings.json lives there), so this has to be ignored by path.
.claude/worktrees/

# Coverage output (npm run test:coverage).
coverage/
