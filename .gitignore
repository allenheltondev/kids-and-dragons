# dependencies
node_modules/
.venv/
__pycache__/
*.py[cod]

# art workflow — nothing reaches assets/ without passing verify + human review
staging/
art/review/

# the asset store's per-checkout state: stat cache, what was last pulled (tools/assets/lib.ts)
.assets/

# build output
dist/
.aws-sam/
cdk.out/
*.tsbuildinfo

# generated chapter graphs (npm run content:graph) — regenerated on each run
.graph/

# wiki generator manifest (local dev state, regenerated on each run)
wiki/.gen-manifest.json
wiki/public/
# Hugo's image-processing cache (gallery thumbnails resized at build time)
wiki/resources/
wiki-public/

# bundled Lambda artifacts — infra/build.mjs regenerates these on every deploy
infra/.build/

# local dev-server table (DynamoDB Local's stand-in)
.data/

# Graph proofs: a cache of each graph campaign's route search, made where it is needed
# (tools/content/graph-proofs.ts). Committed, any two Riftlight branches conflicted here.
content/graph-proofs/

# local
.env
.env.local
*.local
.DS_Store
.kiro
.vscode

# Provider audio a voice:generate run paid for and has not stored yet (tools/voice/render.ts RAW_AUDIO_DIR).
# Never under test-results/, which Playwright empties on every run.
.voice-raw/

# playwright
test-results/
playwright-report/

# Retired local art-tool checkout (not used by the app).
.rive-mcp/

# scratch git worktrees for background agents — each is a full checkout of this
# repo *inside* this repo, created and reaped by the tooling. `.claude/` itself
# is tracked (settings.json lives there), so this has to be ignored by path.
.claude/worktrees/

# Coverage output (npm run test:coverage).
coverage/

# Temporary e2e instrumentation for chasing the session-loss flake. Never committed.
e2e/*.local.spec.ts

# Stryker mutation testing output
.stryker-tmp/
reports/mutation/

# >>> asset store: media live in S3 (assets.config.json, docs/asset-store.md). Written by assets:migrate --untrack.
