          "id": "continue",
          "label": "Watch the folds open",
          "icon": "hand",
          "goto": "gentle"
        }
      ]
    }
  },
  "voiceGuide": {
    "tone": "Warm, funny, curious, with real consequences. Describe actions and sensory details directly. Short dialogue. Never use \"the kind of thing that\", \"the sort of thing that\", or \"it was X, the type of thing that makes you Y\" comparisons. Let a character act instead of explaining how the reader should feel.",
    "vocabulary": "Read aloud to an eight-year-old. Concrete words, short sentences, distinct voices.",
    "forbidden": [
      "death",
      "gore",
      "Corvane",
      "emperor",
      "Pangea",
      "Hollow Gate",
      "Legend Dragon"
    ],
    "npcVoices": {
      "Kitsune keeper": "Calm signal keeper of the whale road. She smooths her whiskers, counts the cloths twice, and never guesses what she cannot see.",
      "New keeper": "A kitsune keeper who has just arrived to take over the watch. She is a little out of breath and wants to learn your signals properly."
    }
  },
