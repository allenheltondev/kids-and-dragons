      }
    },
    "guide_note": {
      "type": "interaction",
      "narration": "Wait for the leading fin to face the lane. Offer your note in the pause.",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        }
      ],
      "art": "scenes/riftlight/whale-road",
      "interaction": {
        "kind": "timing",
        "cue": "Offer the note in the fin-facing interval.",
        "actionLabel": "Invite the turn",
        "target": 0.5,
        "width": 0.3,
        "periodMs": 6000
      },
      "onSuccess": {
        "goto": "last_tail",
        "narration": "The leading whale answers and turns. The others follow."
      },
      "onFailure": {
        "goto": "guide_wait",
        "narration": "Too soon! The whale turns away. The keeper will lead the next try."
      },
      "onAssisted": {
        "goto": "last_tail",
        "narration": "The leading whale answers and turns. The others follow."
      }
    },
    "guide_arms": {
      "type": "interaction",
      "narration": "Hold the low arm greeting where the leading whale can see it.",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        }
      ],
      "art": "scenes/riftlight/whale-road",
      "interaction": {
        "kind": "cooperate",
        "cue": "Keep the arm greeting steady until the keeper sees a turn.",
        "actionLabel": "Watch the leading fin",
        "supportLabel": "Support the greeting arm"
      },
      "onSuccess": {
        "goto": "last_tail",
        "narration": "The leading fin tilts toward you. The others follow."
      },
      "onFailure": {
        "goto": "last_tail",
        "narration": "The leading fin tilts toward you. The others follow."
      },
      "onAssisted": {
        "goto": "last_tail",
        "narration": "The leading fin tilts toward you. The others follow."
      }
    },
    "guide_wait": {
      "type": "interaction",
      "narration": "The keeper sings one last quiet invitation. Help keep the lane clear while she waits.",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        }
      ],
      "art": "scenes/riftlight/whale-road",
      "interaction": {
        "kind": "play",
        "cue": "Give the whales room to answer.",
        "actionLabel": "Finish together",
        "participation": "everyone",
        "options": [
          {
            "id": "quiet",
            "label": "Keep the line quiet",
            "icon": "hand",
            "reaction": "Only the keeper's low note carries."
          },
          {
            "id": "space",
            "label": "Move a bag off the rope",
            "icon": "hand",
            "reaction": "The turning lane stays wide."
          },
          {
            "id": "watch",
            "label": "Point out the leading fin",
            "icon": "hand",
            "reaction": "The keeper waits until it faces the lane."
          }
        ]
      },
      "onSuccess": {
        "goto": "last_tail",
        "narration": "The whale turns, and its family follows."
      },
      "onFailure": {
        "goto": "last_tail",
        "narration": "The whale turns, and its family follows."
      },
      "onAssisted": {
        "goto": "last_tail",
        "narration": "The whale turns, and its family follows."
      }
    },
    "last_tail": {
      "type": "story",
      "narration": "The smallest whale takes its own enormous time. At last its tail clears the folds. The keeper lowers her paw. Olivia stops drawing long enough to just watch the sky.",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
