    "narration": "Above a grassy island, cloud whales turn through the mist. Their long fins move slowly in the open sky. Below them, a broad green landing waits between the clouds."
  },
  "goal": {
    "text": "Help the keeper get the whales' island ready before the folds open.",
    "steps": [
      {
        "id": "learn_signal",
        "label": "Learn the keeper's quiet signal",
        "flag": "practiced_the_whale_signal"
      },
      {
        "id": "make_room",
        "label": "Give the little whale room",
        "flag": "made_room_for_the_whale"
      },
      {
        "id": "teach_keeper",
        "label": "Teach the new keeper the signals",
        "flag": "taught_the_new_keeper"
      }
    ]
  },
  "scenes": {
    "whales": {
      "type": "story",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "entities/cloud_whale",
          "name": "Cloud whale"
        }
      ],
      "rift": "steady",
      "narration": "Cloud whales sweep their long fins through the mist above a grassy island. Two folds pulse together, and each pulse sends the whales circling back. A kitsune keeper holds up a rope to stop the waiting travelers. \"Help me ready the island before those folds open. We need a clear lane and a signal everyone understands.\" A huge whale eye drifts overhead. \"They have watched us fuss all morning.\"",
      "choices": [
        {
          "id": "watch",
          "label": "Watch one full circle",
          "icon": "hand",
          "goto": "olivia"
        }
      ],
      "art": "scenes/riftlight/whale-road"
    },
    "olivia": {
      "type": "story",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        }
      ],
      "rift": "steady",
      "narration": "Lady Olivia, the unicorn Riftseeker you met on the glacier, waits with a notebook. \"Help me hold the note, and I can wake those folds early,\" she says. \"It will scatter the whales.\" \"Or guide them clear first,\" says the keeper. Olivia shrugs. \"Your choice.\"",
      "choices": [
        {
          "id": "continue",
          "label": "Get the island ready first",
          "icon": "hand",
          "goto": "sky_map"
        }
      ],
      "art": "scenes/riftlight/whale-road"
    },
