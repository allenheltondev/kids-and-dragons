          "icon": "hand",
          "goto": "handoff_sky"
        }
      ]
    },
    "handoff_sky": {
      "type": "choice_point",
      "narration": "The first keeper shows the new one two signal cloths. White means watch. Striped means stop and wait. The new keeper must pass each stop from the watcher to the waiting travelers. How will you teach her?",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        }
      ],
      "art": "scenes/riftlight/whale-road",
      "choices": [
        {
          "id": "relay",
          "label": "Practice the relay",
          "icon": "hand",
          "goto": "signal_relay"
        },
        {
          "id": "direct",
          "label": "Let her watch directly",
          "icon": "hand",
          "goto": "signal_memory",
          "when": {
            "flag": "whale_open_view"
          }
        }
      ]
    },
    "signal_relay": {
      "type": "interaction",
      "narration": "Pass the watcher's stop message down the line. The new keeper catches it at the rock and calls it to the travelers.",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        }
      ],
      "art": "scenes/riftlight/whale-road",
      "interaction": {
        "kind": "relay",
        "cue": "Catch the stop message and pass it to the next watcher.",
        "actionLabel": "Pass the stop message",
        "objectLabel": "Watcher's stop message"
      },
      "onSuccess": {
        "goto": "keeper_echo",
        "narration": "The stop reaches the travelers. Nobody steps into the lane."
      },
      "onFailure": {
        "goto": "keeper_echo",
        "narration": "The stop reaches the travelers. Nobody steps into the lane."
      },
      "onAssisted": {
        "goto": "keeper_echo",
        "narration": "The stop reaches the travelers. Nobody steps into the lane."
      }
    },
    "signal_memory": {
      "type": "interaction",
      "narration": "From the viewpoint, show the new keeper the cloths changing. She must remember them when the watcher looks away.",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        }
      ],
      "art": "scenes/riftlight/whale-road",
      "interaction": {
        "kind": "memory",
        "cue": "Watch the cloth pattern, then echo it.",
        "actionLabel": "Show what we saw",
        "options": [
          {
            "id": "wait",
            "label": "Hold at the rope",
            "icon": "eye"
          },
          {
            "id": "stop",
            "label": "Striped stop cloth",
            "icon": "eye"
          },
          {
            "id": "watch",
            "label": "White watching cloth",
            "icon": "eye"
          }
        ],
        "answer": [
          "watch",
          "stop",
          "wait"
        ],
        "stepMs": 1300
      },
      "onSuccess": {
        "goto": "keeper_echo",
        "narration": "The new keeper reads every cloth."
      },
      "onFailure": {
        "goto": "signal_relay",
        "narration": "She mixes up two cloths. You switch to the relay, so every stop is called aloud."
      },
      "onAssisted": {
        "goto": "keeper_echo",
        "narration": "The new keeper reads every cloth."
      }
    },
    "keeper_echo": {
      "type": "story",
      "narration": "The new keeper repeats the stop signal and points to the waiting place on the map. \"A whale's turn means watch,\" says the first keeper. \"It never means cross the rope.\" The keepers take the watch together.",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        }
      ],
      "art": "scenes/riftlight/whale-road",
      "choices": [
        {
          "id": "continue",
          "label": "Hear the keepers' request",
          "icon": "forward",
          "goto": "sky_repair",
          "effects": [
            {
              "type": "setFlag",
              "flag": "taught_the_new_keeper",
              "value": true
            }
          ]
        }
      ]
    },
    "sky_repair": {
      "type": "choice_point",
      "narration": "Olivia keeps her song notes, and the keepers keep the new map. \"If you meet the lookout keepers on your travels, tell them how the whales fared.\" It is a promise to bring news, not to make the whales return. Will you?",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        }
      ],
      "art": "scenes/riftlight/whale-road",
      "choices": [
        {
          "id": "report",
          "label": "Promise to bring news",
          "icon": "hand",
          "goto": "sky_repair_1"
        },
        {
          "id": "local",
          "label": "Leave it with the keepers",
          "icon": "hand",
          "goto": "sky_repair_2"
        }
      ]
    },
    "sky_repair_1": {
      "type": "story",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        }
      ],
      "rift": "steady",
      "narration": "You promise to show the map to neighbors on the island routes, and to tell them whether the whales were guided or scattered. \"Honest news,\" says the keeper. \"That is all I ask.\"",
      "art": "scenes/riftlight/whale-road",
      "choices": [
        {
          "id": "continue",
          "label": "Back to the whales",
          "icon": "hand",
          "goto": "opening_decision",
          "effects": [
            {
              "type": "setFlag",
              "flag": "sky_followup_promised",
              "value": true
            }
          ]
        }
      ]
    },
    "sky_repair_2": {
      "type": "story",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        }
      ],
      "rift": "steady",
      "narration": "You explain that you do not know where your next crossing leads. The keeper nods and keeps the map here. \"Then today's help is enough.\"",
      "art": "scenes/riftlight/whale-road",
      "choices": [
        {
          "id": "continue",
          "label": "Back to the whales",
          "icon": "hand",
          "goto": "opening_decision",
          "effects": [
            {
              "type": "setFlag",
              "flag": "sky_followup_promised",
              "value": false
            }
          ]
        }
      ]
    },
    "opening_decision": {
      "type": "choice_point",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        }
      ],
      "rift": "steady",
      "narration": "The rope is set. The lane is clear. \"Waiting is so slow,\" Olivia sighs. You can finish the gentle invitation, or hear her shortcut: wake the folds early. That would scatter the whales and muddle the neighbors' routes.",
      "choices": [
        {
          "id": "guide",
          "label": "Guide the whales clear",
          "icon": "hand",
          "goto": "guide"
        },
        {
          "id": "consider",
          "label": "Hear Olivia's shortcut",
          "icon": "hand",
          "goto": "offer"
        }
      ],
      "art": "scenes/riftlight/whale-road"
    },
    "gentle": {
      "type": "rest",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        }
      ],
      "rift": "open",
      "narration": "The last tail slips past the folds. Both openings spread wide and hold steady. The keeper lowers the rope. \"Now they can travel without circling us.\" The pair is ready to cross, or you can rest here.",
      "heal": 0,
      "choices": [],
      "outcome": "success",
      "onEnter": [
        {
          "type": "setFlag",
          "flag": "whales_guided",
          "value": true
        }
      ],
      "art": "scenes/riftlight/whale-road-cleared"
    },
    "offer": {
      "type": "rest",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        }
      ],
      "rift": "steady",
      "narration": "Nothing has opened yet. At the rift, Lady Olivia's way will wake the pair early and scatter the whales. You can still guide them clear instead. The keeper leaves the lane open.",
      "heal": 0,
      "choices": [],
      "outcome": "success",
      "art": "scenes/riftlight/whale-road"
    },
    "guide": {
      "type": "choice_point",
      "narration": "The keeper waits beside the open lane. You can pass her invitation from watcher to watcher, or use the greeting you practiced. Either way, the whales choose their own turn. How will you help?",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
        {
          "figure": "cast/new_island_keeper",
          "name": "New keeper"
        }
      ],
      "art": "scenes/riftlight/whale-road",
      "choices": [
        {
          "id": "keeper",
          "label": "Relay her invitation",
          "icon": "hand",
          "goto": "guide_relay"
        },
        {
          "id": "note",
          "label": "Sing our quiet note",
          "icon": "hand",
          "goto": "guide_note",
          "when": {
            "flag": "whale_signal_sung"
          }
        },
        {
          "id": "arms",
          "label": "Hold our arm greeting",
          "icon": "hand",
          "goto": "guide_arms",
          "when": {
            "notFlag": "whale_signal_sung"
          }
        }
      ]
    },
    "guide_relay": {
      "type": "interaction",
      "narration": "When the leading fin faces the lane, pass the keeper's quiet invitation down the line. No extra calls.",
      "cast": [
        {
          "figure": "cast/island_keeper",
          "name": "Kitsune keeper"
        },
        {
          "figure": "cast/lady_olivia",
          "name": "Lady Olivia"
        },
