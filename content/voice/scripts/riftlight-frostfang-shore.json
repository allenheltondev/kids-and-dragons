{
  "$comment": "Who says which words in this chapter (docs/voice-narration-plan.md section 3). Drafted by `npm run voice:script`; a line with no entry is read by the narrator. A person checks each draft and sets `reviewed` to true; re-drafting only touches missing and stale entries.",
  "riftlight-frostfang-shore/bank/narration": {
    "source": "sha256:22c31e6319bd186d483bcd5148bb32ebe0e8c264ac2dd450e699e805db068e9b",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "You come out on the stony shore under the Frostfang Peaks. Behind you, the river is climbing the stones, one pebble at a time. A griffin lands on a ledge above you."
      },
      {
        "by": "tamsin",
        "text": "\"Down, river! Sit!\""
      },
      {
        "by": "narrator",
        "text": "she shouts. The river does not sit."
      },
      {
        "by": "tamsin",
        "text": "\"I'm Tamsin. I keep the river line for the aerie up here. Is everyone here? Good.\""
      },
      {
        "by": "narrator",
        "text": "She waves a wing and nearly falls off."
      },
      {
        "by": "tamsin",
        "text": "\"The only dry ground is up. Can we find a dry way uphill, to the pass called the Cairnstep? Let's find out.\""
      }
    ]
  },
  "riftlight-frostfang-shore/help/narration": {
    "source": "sha256:5a532feb51e7d8ae26c977c71edefb8a9c76b396c24e4c2549fad5caed8f3247",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Tamsin tugs a rope ladder free from under a rock and lowers it down the cliff. Its bottom rung swings above the water."
      },
      {
        "by": "tamsin",
        "text": "\"I can hold the top,\""
      },
      {
        "by": "narrator",
        "text": "she calls."
      },
      {
        "by": "tamsin",
        "text": "\"But if the bottom swings, the first climber rings like a bell. Set its foot on firm ground, please. Quickly. The river is listening.\""
      }
    ]
  },
  "riftlight-frostfang-shore/haul_foot/narration": {
    "source": "sha256:c6f42ed51b8ec80f6f3d245f6a03999a0a99686233574d70485d0a716f9cdcb2",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Everyone grabs the foot of the ladder. The wet rope is as slippery as a fish."
      },
      {
        "by": "tamsin",
        "text": "\"On three!\""
      },
      {
        "by": "narrator",
        "text": "calls Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"One, two, heave!\""
      }
    ]
  },
  "riftlight-frostfang-shore/lash_foot/narration": {
    "source": "sha256:9c8203b851f01d8ad9e1addd9eed5bdf0a57f85f2c0db1bb9e88088834ad5af5",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "You loop your rope around a boulder."
      },
      {
        "by": "tamsin",
        "text": "\"Do you know a good knot?\""
      },
      {
        "by": "narrator",
        "text": "asks Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"I only know a bad one.\""
      }
    ]
  },
  "riftlight-frostfang-shore/brace_foot/narration": {
    "source": "sha256:e09775fb49c5d311e67c1c33cea480e0807ec57c8bc76b2b50bfa00576577e3e",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Your thornguard plants both feet and holds the ladder still."
      },
      {
        "by": "tamsin",
        "text": "\"Oh, that's handy,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      }
    ]
  },
  "riftlight-frostfang-shore/foot_set/narration": {
    "source": "sha256:409e105757117c13767ef3ca1e9102d632100fef5c9ac3d643b71a034caab3f9",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The ladder's foot sits on the rock, steady. Tamsin tests it and squawks happily."
      },
      {
        "by": "tamsin",
        "text": "\"Somebody hold it, and somebody climb three rungs. Tell me what you see on the cliff.\""
      }
    ]
  },
  "riftlight-frostfang-shore/foot_set/variants/0": {
    "source": "sha256:b93143207cbca613092fa5a0a1e0f24ebbe6659694a7a08021901863e3fb5cf5",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The ladder's foot sits on the rock, but it wobbles."
      },
      {
        "by": "tamsin",
        "text": "\"It will do,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"Somebody hold it, and somebody climb three rungs. Tell me what you see on the cliff.\""
      }
    ]
  },
  "riftlight-frostfang-shore/river_line/narration": {
    "source": "sha256:aa9eab70ec61a33ce95d3b30380aa08296bb6050485de7db49b511ff9bb9903e",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The cliff is striped with paint: old white lines, one above another, each with a year scratched beside it."
      },
      {
        "by": "tamsin",
        "text": "\"The river line,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"Every spring, the keeper paints where the highest water reached. My grandmother painted that top one, the year the whole shore flooded.\""
      },
      {
        "by": "narrator",
        "text": "She looks down. The river is above it. Above every line."
      },
      {
        "by": "tamsin",
        "text": "\"It has never come this high,\""
      },
      {
        "by": "narrator",
        "text": "she says quietly."
      },
      {
        "by": "tamsin",
        "text": "\"Not once, in all the paint.\""
      }
    ]
  },
  "riftlight-frostfang-shore/driftline/narration": {
    "source": "sha256:23276ae4232de3cf11ea20b93ca4580431e6bb63a588339c38928fc103548ca0",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Along the shore, the flood has dumped driftwood, one lonely boot, and a big net of hay tied in yeti knots. The net bobs at the water's edge."
      },
      {
        "by": "tamsin",
        "text": "\"Hay for the snowhorn herd!\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"That's their winter. If it floats off, it's gone.\""
      }
    ]
  },
  "riftlight-frostfang-shore/net_saved/narration": {
    "source": "sha256:aa33a74de675f12a742d4f6b928fd31d3d313084875336d60ee71bf608c1835c",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Then you hear a tiny bell. Out on a gravel bar in the river stand three snowhorn goats, huddled tight."
      },
      {
        "by": "tamsin",
        "text": "\"Goats from the herd!\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"The water cut off their grazing route. They won't swim, and I can't carry a goat. I tried once. The goat won.\""
      },
      {
        "by": "narrator",
        "text": "Tucked in the wet hay you find five coins, and Tamsin drops you a supper bundle."
      },
      {
        "by": "tamsin",
        "text": "\"For the goats, or for you.\""
      }
    ]
  },
  "riftlight-frostfang-shore/bar/narration": {
    "source": "sha256:52f9f851d58a0f668ad243e47b25724996630bc8d69e748c058e815fb4561353",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The bar sits in a brown stream that was not there this morning."
      },
      {
        "by": "tamsin",
        "text": "\"Knee deep and quick,\""
      },
      {
        "by": "narrator",
        "text": "Tamsin warns."
      },
      {
        "by": "tamsin",
        "text": "\"Down, river.\""
      },
      {
        "by": "narrator",
        "text": "The smallest goat sneezes. How will you reach them?"
      }
    ]
  },
  "riftlight-frostfang-shore/bar_reached/narration": {
    "source": "sha256:e5e14abe7e613851703bb5367a519a93302ec805c61dda02eafdbcb89cda6b4a",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "On the bar, the goats lean away from you. The biggest has a cracked horn and a very cross face. The smallest wears a bell that jingles when it shivers. Between you and them sits one of the glassback crabs that live by this river."
      },
      {
        "by": "tamsin",
        "text": "\"Its burrow washed out,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"So now this bar is its house.\""
      }
    ]
  },
  "riftlight-frostfang-shore/bar_carry/narration": {
    "source": "sha256:8b845599b2546bccc94ee60a709578c90e14f35daf7f581b25f128f3f0f957d4",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The smallest goat cannot wade water that deep. You lift it in a rope sling. It jingles in protest. The stream surges and slackens, surges and slackens."
      },
      {
        "by": "tamsin",
        "text": "\"Go when it drops,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      }
    ]
  },
  "riftlight-frostfang-shore/kid_swept/narration": {
    "source": "sha256:aa5e7ac7f5739db0ffca3b0af59859d1ca4912549bf2ba256051599ea1908763",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Tamsin dives. She grabs the kid by its scruff and flaps it back to the shore. Then she lands hard, holding one wing out at a funny angle."
      },
      {
        "by": "tamsin",
        "text": "\"I'm fine,\""
      },
      {
        "by": "narrator",
        "text": "she says."
      },
      {
        "by": "tamsin",
        "text": "\"Mostly. Wings are mostly fine.\""
      },
      {
        "by": "narrator",
        "text": "The kid shakes itself dry all over her."
      }
    ]
  },
  "riftlight-frostfang-shore/goats/narration": {
    "source": "sha256:cc9a0c6cfa62393560f7294344cd74212960f494b63e0327ff39eaa212eec898",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The two big goats will not wade. The boss goat, the one with the cracked horn, stamps and stares past you, up at the cliff."
      },
      {
        "by": "tamsin",
        "text": "\"Push them across now,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin,"
      },
      {
        "by": "tamsin",
        "text": "\"before the water climbs any higher.\""
      },
      {
        "by": "narrator",
        "text": "She squints."
      },
      {
        "by": "tamsin",
        "text": "\"Or watch it. That goat is looking at something. Goats always know something.\""
      }
    ]
  },
  "riftlight-frostfang-shore/boss_sulk/narration": {
    "source": "sha256:17424032b2d9d6d2cc22fc70df5f59564ee5104857e43b976caae557b5514dee",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The boss goat sits in the stream like a hairy boulder. The water is up to its beard."
      },
      {
        "by": "tamsin",
        "text": "\"Out!\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"Out, you great lump!\""
      },
      {
        "by": "narrator",
        "text": "It does not move. It is waiting for an apology."
      }
    ]
  },
  "riftlight-frostfang-shore/goat_track_seen/narration": {
    "source": "sha256:9fe11e3891866af20d61dd8db631b4a0a3bf7c858163102ba612aa5727340659",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Up the cliff, too faint to see unless you are a goat, runs a zigzag of tiny ledges: an old goat track, dry all the way up. The boss goat huffs, as if to say \"finally,\" and wades for the shore. The other trots after its boss."
      },
      {
        "by": "tamsin",
        "text": "\"Well,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"I've lived here my whole life.\""
      }
    ]
  },
  "riftlight-frostfang-shore/goat_back/narration": {
    "source": "sha256:156dafd9cdea74aed886b77276c0277e4b59498936ab635c0b4bd45f3137414b",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The goats scramble ashore and shake like dogs, spraying everybody."
      },
      {
        "by": "tamsin",
        "text": "\"There,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"The herd has all its horns again.\""
      },
      {
        "by": "narrator",
        "text": "She counts them twice, then counts you."
      }
    ]
  },
  "riftlight-frostfang-shore/goat_back/variants/2": {
    "source": "sha256:12b1baf8328d55db39ea22c7106539b50f64a35889864cab2f316d924e17db9e",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Behind you, while you watched, the river crept up the shore and carried the hay away. Tamsin sighs."
      },
      {
        "by": "tamsin",
        "text": "\"Hay floats. Goats don't. Fair trade.\""
      }
    ]
  },
  "riftlight-frostfang-shore/rest_fire/narration": {
    "source": "sha256:7d464651d516102371854503c7b9e5c5912294621d8fcfa82d64c387dc81bc95",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Tamsin breaks open a driftwood log. Its heart is dry, and it catches at the first spark. For a few minutes, the shore is cozy. Steam rises from the goats, and from your socks. One sock smells like river pudding."
      },
      {
        "by": "tamsin",
        "text": "\"We climb next,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"But nobody climbs my ladder with stiff fingers.\""
      }
    ]
  },
  "riftlight-frostfang-shore/rest_socks/narration": {
    "source": "sha256:222898cec8334429b79b1b246baa6a7ab1f03eca20961208c0a10fc958b8e3c8",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Your socks steam on a stick like little flags. The smallest goat nibbles one, thinks about it, and spits it out."
      },
      {
        "by": "tamsin",
        "text": "\"Good taste,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      }
    ]
  },
  "riftlight-frostfang-shore/rest_share/narration": {
    "source": "sha256:2e315abf53ac018238c5a80d99ab4f6126de29c5b7e9e87cf728778deda0ffdd",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "You share the supper, a bit for everyone, goats included. Tamsin gets cheese in her feathers and leaves it there. She hands you a bright ribbon from her bag."
      },
      {
        "by": "tamsin",
        "text": "\"We wear these on feast days. Wear it for luck.\""
      }
    ]
  },
  "riftlight-frostfang-shore/rest_story/narration": {
    "source": "sha256:038caa568dc6a62f8c0f1b7d8dea152140eb64ff99fd68782d6148ae25bafc61",
    "reviewed": false,
    "lines": [
      {
        "by": "tamsin",
        "text": "\"Our aerie is above the ridge,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"Our keeper keeps a pass ledger, a book of every road through the peaks. This season it shows a new path he can't quite believe. He needs someone to walk it.\""
      },
      {
        "by": "narrator",
        "text": "She looks at the river."
      },
      {
        "by": "tamsin",
        "text": "\"I'll tell him about my paint too. He'll want it in the book.\""
      }
    ]
  },
  "riftlight-frostfang-shore/surge/narration": {
    "source": "sha256:66d7960e12ff2ccefcf17e136d3b985dd2193cef86861b6ad923add2c55c1cc7",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Crack! Upriver, a slab of ice breaks off the cliffs. A brown wave rolls down the shore with foam on top, like a bad hat."
      },
      {
        "by": "tamsin",
        "text": "\"Ladder! Now!\""
      },
      {
        "by": "narrator",
        "text": "shouts Tamsin. The goats are already running for the cliff."
      }
    ]
  },
  "riftlight-frostfang-shore/surge_after/narration": {
    "source": "sha256:d4921a3071146cd4f1f4d033c28d690edc596ae207ac425e188bad1bb9a93340",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The wave breaks around the ladder, which does not budge."
      },
      {
        "by": "tamsin",
        "text": "\"Still standing,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin. The river settles higher, right where you stood a minute ago."
      },
      {
        "by": "tamsin",
        "text": "\"Down, river,\""
      },
      {
        "by": "narrator",
        "text": "she says, more quietly."
      }
    ]
  },
  "riftlight-frostfang-shore/surge_after/variants/0": {
    "source": "sha256:6ebc1ee60697783f8671501a80b543b6fdbb4f805ce03540ba96d94b50638f28",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The wave swings the wobbly ladder hard. Tamsin hangs on with both claws until it settles. The river settles higher, right where you stood a minute ago."
      },
      {
        "by": "tamsin",
        "text": "\"Down, river,\""
      },
      {
        "by": "narrator",
        "text": "she says, more quietly."
      }
    ]
  },
  "riftlight-frostfang-shore/wave_gap/narration": {
    "source": "sha256:4ffc93a34ee41a91a9110e55fed5d42c1b2b38dbc882b364128db80146118454",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "A smaller wave pulls back with a long hiss. For a moment, the stones by the ladder are bare."
      },
      {
        "by": "tamsin",
        "text": "\"Wait for it,\""
      },
      {
        "by": "narrator",
        "text": "calls Tamsin."
      }
    ]
  },
  "riftlight-frostfang-shore/wave_catch/narration": {
    "source": "sha256:c9bf48cf64ab8bf7e8e9f5a9c4d18be4b3477c36e57586586af75bb92ee1d852",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The wave catches your ankles and sits you down in it. Tamsin hauls you up by the collar, one at a time."
      },
      {
        "by": "tamsin",
        "text": "\"Up. Up. Everyone up.\""
      },
      {
        "by": "narrator",
        "text": "Your boots are full of river, and it sloshes with every step."
      }
    ]
  },
  "riftlight-frostfang-shore/climb_line/narration": {
    "source": "sha256:dd944cc5a898d42ca3662438ae2547c05dc43d907fb521151a83366c6ff3cf42",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "The lightest climber goes first."
      },
      {
        "by": "tamsin",
        "text": "\"Don't look down,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"Look at me. I'm lovely.\""
      }
    ]
  },
  "riftlight-frostfang-shore/top/narration": {
    "source": "sha256:301ead243074470fe8d31d60c79e6409063de4d5b90754519b53cb681e4bd1be",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "You flop onto the rock at the top. It is dry. Really dry! A path lined with stacked stones winds along the ridge toward a notch."
      },
      {
        "by": "tamsin",
        "text": "\"The Cairnstep,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"Its keeper is a griffin called Brask. He keeps the pass ledger, our book of roads. He has more ink on his feathers than on the page.\""
      }
    ]
  },
  "riftlight-frostfang-shore/chime/narration": {
    "source": "sha256:5b87a4b7070935276e2c09836a6bf7bc8b6048b1214d231bb1e0098983feaab5",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Up here, out of the wind, the Listening Chime on your pack begins to hum. It swings on its cord, not down toward the river, but up the valley, toward the glacier far away. It hangs there, leaning, then goes still. Tamsin's feathers prickle."
      },
      {
        "by": "tamsin",
        "text": "\"Your bell is pointing,\""
      },
      {
        "by": "narrator",
        "text": "she says."
      },
      {
        "by": "tamsin",
        "text": "\"Bells don't point.\""
      }
    ]
  },
  "riftlight-frostfang-shore/safety/narration": {
    "source": "sha256:136fb582c0e5c903a87702105df9829024ff567b119b56fe1f1986ffed5c3154",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Below, the river laps above the top line of paint."
      },
      {
        "by": "tamsin",
        "text": "\"It will rise again tomorrow,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"The next travelers out of that river will be wetter and more tired than you. A handrail would help them.\""
      },
      {
        "by": "narrator",
        "text": "She looks at your rope, then at you."
      },
      {
        "by": "tamsin",
        "text": "\"Only if you can spare it.\""
      }
    ]
  },
  "riftlight-frostfang-shore/safety_rope/narration": {
    "source": "sha256:b60dc6fb5f0c40bdc702d68a2daca546ff8d9061dc9313d6406fcce9823998c7",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "You tie your rope from the old boulder at the top down to the first ledge, with a fat, neat knot. Tamsin leans her whole chest on it, which is a lot of griffin. It holds."
      },
      {
        "by": "tamsin",
        "text": "\"Somebody will thank you in the dark,\""
      },
      {
        "by": "narrator",
        "text": "she says, and hangs a smooth river charm aaround your neck."
      },
      {
        "by": "tamsin",
        "text": "\"We give one to anyone who ties a rail.\""
      }
    ]
  },
  "riftlight-frostfang-shore/safety_buy/narration": {
    "source": "sha256:a5779417a474066c9fc0995d88af266ddab1cf27a2813128d1d03b8d21f8a170",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Tamsin sells pegs to buy ink for the aerie. Her best one rings like a bell. You hammer it deep into a crack, thunk, thunk, thunk, and she ties her own spare line to it."
      },
      {
        "by": "tamsin",
        "text": "\"Somebody will thank you in the dark,\""
      },
      {
        "by": "narrator",
        "text": "she says, and hangs a smooth river charm aaround your neck."
      },
      {
        "by": "tamsin",
        "text": "\"We give one to anyone who ties a rail.\""
      }
    ]
  },
  "riftlight-frostfang-shore/safety_leave/narration": {
    "source": "sha256:757e4f4bbe51c142490eab2e8cfb5f1371e0eabe0db34dae7c4b185642b16930",
    "reviewed": false,
    "lines": [
      {
        "by": "tamsin",
        "text": "\"Fair enough,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"You've done plenty.\""
      },
      {
        "by": "narrator",
        "text": "She pats the boulder."
      },
      {
        "by": "tamsin",
        "text": "\"I'll tie one here myself, first thing tomorrow.\""
      }
    ]
  },
  "riftlight-frostfang-shore/safety_leave/variants/0": {
    "source": "sha256:32901e94a70376b5b9824aa6ebbc537093962e6ab1137cac1c14822ad459d615",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "She looks at her sore wing."
      },
      {
        "by": "tamsin",
        "text": "\"When this works again. Soon.\""
      }
    ]
  },
  "riftlight-frostfang-shore/climb/variants/0": {
    "source": "sha256:61a5952dda508c9ab925deaccf4974c72ccb5c1195763e9d753b881746796e93",
    "reviewed": false,
    "lines": [
      {
        "by": "tamsin",
        "text": "\"I'll fly ahead and tell Brask you're coming,\""
      },
      {
        "by": "narrator",
        "text": "says Tamsin."
      },
      {
        "by": "tamsin",
        "text": "\"And about my paint.\""
      }
    ]
  },
  "riftlight-frostfang-shore/climb/variants/1": {
    "source": "sha256:9917951b934bbffdf19720b2a9a6499b02f4b85f4010840f3ef5a4d9936bc1c9",
    "reviewed": false,
    "lines": [
      {
        "by": "narrator",
        "text": "Tamsin can't fly far with that wing tonight."
      },
      {
        "by": "tamsin",
        "text": "\"Tell Brask about my paint,\""
      },
      {
        "by": "narrator",
        "text": "she says."
      },
      {
        "by": "tamsin",
        "text": "\"Tell him exactly.\""
      }
    ]
  }
}
