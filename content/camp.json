    {
      "id": "bun",
      "figure": "cast/bun",
      "name": "Bun",
      "offers": [{ "rewardId": "first-steps-01.bun", "chapter": "first-steps-01" }],
      "reactions": [
        "Bun bleats and wiggles all four legs at once.",
        "Bun nibbles your sleeve. That means hello in goat.",
        "Bun hops in a circle, then flops over on purpose.",
        "Bun leans on you and lets out a happy goat sigh."
      ]
    },
    {
      "id": "mosshorn",
      "figure": "entities/mosshorn",
      "size": "small",
      "name": "Mosshorn",
      "offers": [{ "rewardId": "gemfall-04b.mosshorn", "chapter": "gemfall-04b" }],
      "reactions": [
        "The mosshorn lowers its antlers. A strawberry rolls off.",
        "The mosshorn sniffs your hair and hums.",
        "Tiny flowers on its antlers open up, just for you.",
        "The mosshorn nudges you with its soft green nose."
      ]
    },
    {
      "id": "duckling",
      "figure": "entities/duckling",
      "name": "Duckling",
      "offers": [{ "rewardId": "riftlight-ashspan-bridge.duckling", "chapter": "riftlight-ashspan-bridge" }],
      "reactions": [
        "Peep! The duckling waddles in a happy circle.",
        "The duckling tucks its head under your hand.",
        "Peep peep! It tries to quack and sneezes instead.",
        "The duckling fluffs up until it is twice as round."
      ]
    },
    {
      "id": "kid_goat",
      "figure": "cast/snowhorn_kid",
      "name": "Spotted kid goat",
      "offers": [{ "rewardId": "riftlight-glacier-survival.kid_goat", "chapter": "riftlight-glacier-survival" }],
      "reactions": [
        "The spotted kid goat bounces straight up like a spring.",
        "Maa! The spotted kid goat wiggles so hard her whole back end wags.",
        "The spotted kid goat chews your bootlace, very politely.",
        "The spotted kid goat does a tiny dance on the tips of her hooves."
      ]
    },
    {
      "id": "harbor_gull",
      "figure": "entities/quay_gull",
      "name": "Harbor gull",
      "offers": [
        { "rewardId": "gemfall-01.gull", "chapter": "gemfall-01" },
        { "rewardId": "riftlight-exchange-rift.gull", "chapter": "riftlight-exchange-rift" }
      ],
      "reactions": [
        "The gull looks at your pocket. Just checking.",
        "Hmph. The gull stands on one foot, then the other.",
        "The gull fluffs up and pretends it did not want a pat.",
        "The gull gives one loud screech. That means hello in gull."
      ]
    },
    {
      "id": "silver_otter",
      "figure": "entities/silver_otter",
      "name": "Silver otter",
      "offers": [{ "rewardId": "gemfall-02.otter", "chapter": "gemfall-02" }],
      "reactions": [
        "The otter shows you its blue pebble. You may look, but not touch.",
        "The otter rolls onto its back and wiggles happily.",
        "The otter gives you back a button. It is not yours, but it is very shiny.",
        "The otter chatters at you, then pats your boot twice."
      ]
